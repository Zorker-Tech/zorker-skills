{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/page-content.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "route", "type", "intent", "audiences", "primaryActionId", "sections", "seo"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "route": { "type": "string", "pattern": "^/" },
    "type": { "type": "string" },
    "intent": { "type": "string", "minLength": 1 },
    "audiences": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "primaryActionId": { "type": "string" },
    "sections": { "type": "array", "minItems": 1 },
    "seo": {
      "type": "object",
      "required": ["title", "description"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
