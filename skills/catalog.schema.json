{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zorker.dev/schemas/skill-catalog.schema.json",
  "type": "object",
  "required": ["catalogVersion", "skills"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "displayName", "description", "version", "path", "entry"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 20 },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "path": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "entry": { "const": "SKILL.md" },
          "commands": { "type": "object", "additionalProperties": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
